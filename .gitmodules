[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "binsreg"]
	path = binsreg
	url = https://github.com/cran/binsreg
[submodule "rd2d"]
	path = rd2d
	url = https://github.com/cran/rd2d
[submodule "rdlocrand"]
	path = rdlocrand
	url = https://github.com/cran/rdlocrand
